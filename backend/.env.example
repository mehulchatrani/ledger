PORT=4000
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token
JWT_SECRET=replace-with-a-long-random-secret
# Optional JWT lifetime, for example: 30d, 90d, or 12h
JWT_EXPIRES_IN=30d
AUTH_USERNAME=client
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
AUTH_PASSWORD_HASH=replace-with-bcrypt-hash
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAIL=client@example.com
